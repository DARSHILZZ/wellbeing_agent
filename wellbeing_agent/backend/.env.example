# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Project Settings → Database → Connection string → URI (Session pooler, port 5432)
# URL-encode special characters in password (@ → %40, # → %23)
DATABASE_URL=postgresql://postgres.YOUR_REF:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── AI APIs (FastAPI only — never expose to frontend) ─────────────────────────
GROK_API_KEY=
GEMINI_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]
